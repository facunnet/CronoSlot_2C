#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(4, 4, 0)
void OnDataRecv(const esp_now_recv_info * info, const uint8_t *incomingData, int len) {
#else
void OnDataRecv(const uint8_t * mac, const uint8_t *incomingData, int len) {
#endif
  if (len >= 3 && incomingData[0] == 0x99) {
    if (incomingData[1] == 1) peticionReinicio = true;
    if (incomingData[2] == 1) peticionCambioModo = true;
    peticionBuzzer = true; 
  }
}

unsigned long IRAM_ATTR obtenerTiempoCarrera() {
  if (carreraActiva) return millis() - tiempoTotalPausado;
  else return inicioPausa - tiempoTotalPausado;
}

void IRAM_ATTR ISR_PausaPista() { peticionPausa = true; }
void IRAM_ATTR ISR_ReanudarPista() { peticionReanudar = true; }
void IRAM_ATTR ISR_Carril1() { if(!nuevaVueltaPendiente[0]){ tiempoDisparo[0] = millis(); nuevaVueltaPendiente[0] = true; } }
void IRAM_ATTR ISR_Carril2() { if(!nuevaVueltaPendiente[1]){ tiempoDisparo[1] = millis(); nuevaVueltaPendiente[1] = true; } }

void ejecutarResetVariables(bool iniciarInmediato = true) {
  carreraFinalizada = false;
  idGanador = -1;
  estadoSemaforoVirtual = 0;
  for(int i=0; i<NUM_CARRILES; i++) {
    carriles[i].vueltas = 0;
    carriles[i].tiempoUltimaVuelta = 0;
    carriles[i].mejorTiempo = 999999;
    carriles[i].tiempoVueltaActual = 0;
  }
  
  if (iniciarInmediato || modoActual == MODO_LIBRE) {
    carreraActiva = true; 
    carreraEnEspera = false;
  } else {
    carreraActiva = false; 
    carreraEnEspera = true;
  }
  
  inicioPausa = millis();
  tiempoTotalPausado = millis(); 
}

