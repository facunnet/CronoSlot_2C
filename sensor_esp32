  html += "nuevoContenido += `<tr><td style='color:#777;'>${posicion + 1}º</td><td class='${infoCarriles[auto.id].clase}'>${nPiloto}</td><td class='modelo-auto'>${mAuto}</td><td>${textoVueltas}</td><td>${ult}</td><td>${mej}</td><td class='dif-leader'>${difTexto}</td></tr>`;";
  html += "}); tbody.innerHTML = nuevoContenido; ";
  html += "setTimeout(pedirDatos, 800); }).catch(e => setTimeout(pedirDatos, 1500)); }";
  html += "pedirDatos();"; 
  html += "</script></body></html>";
  server.send(200, "text/html", html);
}

void handleDatos() {
  String json;
  json.reserve(500); 
  json = "{\"activa\":";
  json += carreraActiva ? "true" : "false";
  json += ",\"fin\":";
  json += carreraFinalizada ? "true" : "false";
  json += ",\"espera\":";
  json += carreraEnEspera ? "true" : "false";
  json += ",\"modo\":" + String((int)modoActual);
  json += ",\"tCarrera\":" + String(obtenerTiempoCarrera());
  json += ",\"tLimite\":" + String(limiteTiempoMs);
  json += ",\"relojDesc\":";
  json += relojDescendente ? "true" : "false";
  
  if (idGanador >= 0 && idGanador < NUM_CARRILES) {
    json += ",\"ganadorId\":" + String(idGanador);
    json += ",\"ganadorNombre\":\"" + nombresPilotos[idGanador] + "\"";
  } else {
    json += ",\"ganadorId\":-1,\"ganadorNombre\":\"\"";
  }
  
  json += ",\"autos\":[";
  for(int i=0; i<NUM_CARRILES; i++) {
    int vueltasNetas = carriles[i].vueltas - lastreVueltas[i];
    json += "{\"nombre\":\"" + nombresPilotos[i] + "\",\"modelo\":\"" + modelosAutos[i] + "\",\"vueltas\":" + String(vueltasNetas) + ",\"reales\":" + String(carriles[i].vueltas) + ",\"lastre\":" + String(lastreVueltas[i]) + ",\"ultima\":" + String(carriles[i].tiempoVueltaActual) + ",\"mejor\":" + String(carriles[i].mejorTiempo == 999999 ? 0 : carriles[i].mejorTiempo) + "}";
    if(i < NUM_CARRILES - 1) json += ",";
  }
  json += "]}";
  server.send(200, "application/json", json);
}

void handleToggleRelojDir() {
  relojDescendente = !relojDescendente;
  preferences.begin("pista-slot", false);
  preferences.putBool("relojDesc", relojDescendente);
  preferences.end();
  server.send(200, "text/plain", relojDescendente ? "1" : "0");
}

void handleSetCarrera() {
  if (server.hasArg("modo")) {
    modoActual = (ModoCarrera)server.arg("modo").toInt();
    int valor = server.hasArg("valor") ? server.arg("valor").toInt() : 0;
    
    if (modoActual == MODO_VUELTAS) { limiteVueltas = valor; } 
    else if (modoActual == MODO_TIEMPO) { limiteTiempoMs = (unsigned long)valor * 60000; }
    
    preferences.begin("pista-slot", false);
    preferences.putInt("modoCar", (int)modoActual);
    preferences.putInt("limVueltas", limiteVueltas);
    preferences.putULong("limTiempo", limiteTiempoMs);
    preferences.end();
    
    ejecutarResetVariables(false);
  }
  server.send(200, "text/plain", "OK");
}

void handleToggleComisario() {
  comisarioHabilitado = !comisarioHabilitado;
  if (!comisarioHabilitado && !carreraActiva && !carreraFinalizada && !carreraEnEspera) {
    carreraActiva = true;
    tiempoTotalPausado += (millis() - inicioPausa);
  }
  server.send(200, "text/plain", comisarioHabilitado ? "1" : "0");
}

void handleToggleBuzzer() {
  buzzerHabilitado = !buzzerHabilitado;
  preferences.begin("pista-slot", false);
  preferences.putBool("buzzerEna", buzzerHabilitado);
  preferences.end();
  server.send(200, "text/plain", buzzerHabilitado ? "1" : "0");
}

void handleSetBrillo() {
  if (server.hasArg("val")) {
    nivelBrilloLED = server.arg("val").toInt();
    preferences.begin("pista-slot", false);
    preferences.putInt("brillo", nivelBrilloLED);
    preferences.end();
  }
  server.send(200, "text/plain", "OK");
}

void handleGuardarPilotos() {
  preferences.begin("pista-slot", false); 
  for (int i = 0; i < NUM_CARRILES; i++) {
    String pP = "p" + String(i); String pM = "m" + String(i); String pL = "l" + String(i);
    if (server.hasArg(pP)) { String n = server.arg(pP); n.trim(); if(n.length() == 0) n = "Piloto " + String(i+1); nombresPilotos[i] = n; preferences.putString(pP.c_str(), n); }
    if (server.hasArg(pM)) { String m = server.arg(pM); m.trim(); if(m.length() == 0) m = "Auto " + String(i+1); modelosAutos[i] = m; preferences.putString(pM.c_str(), m); }
    if (server.hasArg(pL)) { lastreVueltas[i] = server.arg(pL).toInt(); preferences.putInt(pL.c_str(), lastreVueltas[i]); }
  }
  preferences.end(); server.send(200, "text/plain", "OK");
}

void handleReset() {
  peticionReinicio = true;
  peticionBuzzer = true; 
  contadorComandosRx++;
  server.send(200, "text/plain", "OK");
}

void setup() {
  Serial.begin(115200);
  delay(1000); 

  preferences.begin("pista-slot", true); 
  for(int i=0; i<NUM_CARRILES; i++) {
    String keyP = "p" + String(i); String keyM = "m" + String(i); String keyL = "l" + String(i);
    if(preferences.isKey(keyP.c_str())) nombresPilotos[i] = preferences.getString(keyP.c_str(), nombresPilotos[i]);
    if(preferences.isKey(keyM.c_str())) modelosAutos[i] = preferences.getString(keyM.c_str(), modelosAutos[i]);
    if(preferences.isKey(keyL.c_str())) lastreVueltas[i] = preferences.getInt(keyL.c_str(), lastreVueltas[i]);
  }
  
  if(preferences.isKey("buzzerEna")) buzzerHabilitado = preferences.getBool("buzzerEna", true);
  if(preferences.isKey("brillo")) nivelBrilloLED = preferences.getInt("brillo", 5);
  if(preferences.isKey("modoCar")) modoActual = (ModoCarrera)preferences.getInt("modoCar", 0);
  if(preferences.isKey("limVueltas")) limiteVueltas = preferences.getInt("limVueltas", 0);
  if(preferences.isKey("limTiempo")) limiteTiempoMs = preferences.getULong("limTiempo", 0);
  if(preferences.isKey("relojDesc")) relojDescendente = preferences.getBool("relojDesc", true);
  preferences.end();

  pinMode(PIN_BUZZER, OUTPUT);
  pinMode(PIN_RELE, OUTPUT);
  digitalWrite(PIN_RELE, HIGH);

  for(int i=0; i<NUM_CARRILES; i++) pinMode(pinesSensores[i], INPUT_PULLUP);
  
  pinMode(PIN_PAUSA_PISTA, INPUT_PULLUP);
  pinMode(PIN_REANUDAR_PISTA, INPUT_PULLUP);
  carreraActiva = true; 

  attachInterrupt(digitalPinToInterrupt(pinesSensores[0]), ISR_Carril1, FALLING);
  attachInterrupt(digitalPinToInterrupt(pinesSensores[1]), ISR_Carril2, FALLING);
  attachInterrupt(digitalPinToInterrupt(PIN_PAUSA_PISTA), ISR_PausaPista, FALLING);
  attachInterrupt(digitalPinToInterrupt(PIN_REANUDAR_PISTA), ISR_ReanudarPista, FALLING);

  WiFi.mode(WIFI_AP); 
  esp_wifi_set_ps(WIFI_PS_NONE); 
  
  IPAddress local_ip(192, 168, 4, 1);
  IPAddress gateway(192, 168, 4, 1);
  IPAddress subnet(255, 255, 255, 0);
  WiFi.softAPConfig(local_ip, gateway, subnet);
  WiFi.softAP(ssid_AP, password_AP, 5); 

  if (esp_now_init() != ESP_OK) return;
  
  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, direccionBroadcast, 6);
  peerInfo.channel = 5;  
  peerInfo.encrypt = false;
  peerInfo.ifidx = WIFI_IF_AP; 
  if (esp_now_add_peer(&peerInfo) != ESP_OK) return;
  
  esp_now_register_recv_cb((esp_now_recv_cb_t)OnDataRecv);

  server.on("/cmdModo", []() {
    peticionCambioModo = true; peticionBuzzer = true; contadorComandosRx++; server.send(200, "text/plain", "OK");
  });
  server.on("/toggleComisario", handleToggleComisario);
  server.on("/toggleBuzzer", handleToggleBuzzer); 
  server.on("/toggleRelojDir", handleToggleRelojDir); 
  server.on("/setBrillo", handleSetBrillo); 
  server.on("/", handleRoot);
  server.on("/datos", handleDatos);
  server.on("/guardarPilotos", handleGuardarPilotos);
  server.on("/setCarrera", handleSetCarrera); 
  server.on("/reset", handleReset);
  
  server.on("/prepararLargada", []() {
    ejecutarResetVariables(false); 
    semaforoHardwareActivo = true;
    inicioSemaforo = millis();
    server.send(200, "text/plain", "OK");
  });
  
  server.begin();
}

void loop() {
  server.handleClient(); 
  
  if (peticionReinicio) { peticionReinicio = false; ejecutarResetVariables(true); }

  if (peticionCambioModo) {
    peticionCambioModo = false;
    int nuevoModo = (int)modoActual + 1;
    if (nuevoModo > 2) nuevoModo = 0; 
    modoActual = (ModoCarrera)nuevoModo;
    preferences.begin("pista-slot", false); preferences.putInt("modoCar", (int)modoActual); preferences.end();
    ejecutarResetVariables(true); 
  }

  bool debeCortarRele = carreraFinalizada || carreraEnEspera;
  digitalWrite(PIN_RELE, debeCortarRele ? LOW : HIGH);

  if (peticionBuzzer) {
    peticionBuzzer = false;
    if(!semaforoHardwareActivo) tone(PIN_BUZZER, 1000); 
    buzzerEncendido = true;
    tiempoInicioBuzzer = millis();
  }

  if (buzzerEncendido && (millis() - tiempoInicioBuzzer > 100)) { noTone(PIN_BUZZER); buzzerEncendido = false; }
  
  // --- MÁQUINA DE ESTADOS: SEMÁFORO ESTILO FÓRMULA 1 ---
  if (semaforoHardwareActivo) {
    unsigned long tSemaforo = millis() - inicioSemaforo;
    int estadoSemTemp = 0;
    
    if (tSemaforo < 1000) { 
      estadoSemTemp = 1; 
      if (tSemaforo < 200) tone(PIN_BUZZER, 440); else noTone(PIN_BUZZER); 
    } 
    else if (tSemaforo < 2000) { 
      estadoSemTemp = 2; 
      if (tSemaforo >= 1000 && tSemaforo < 1200) tone(PIN_BUZZER, 440); else noTone(PIN_BUZZER); 
    } 
    else if (tSemaforo < 3000) { 
      estadoSemTemp = 3; 
      if (tSemaforo >= 2000 && tSemaforo < 2200) tone(PIN_BUZZER, 440); else noTone(PIN_BUZZER); 
    } 
    else if (tSemaforo < 4000) { 
      estadoSemTemp = 4; 
      if (tSemaforo >= 3000 && tSemaforo < 3200) tone(PIN_BUZZER, 440); else noTone(PIN_BUZZER); 
    } 
    else if (tSemaforo < 5000) { 
      estadoSemTemp = 5; 
      if (tSemaforo >= 4000 && tSemaforo < 4200) tone(PIN_BUZZER, 440); else noTone(PIN_BUZZER); 
    } 
    else if (tSemaforo < 6500) { 
      estadoSemTemp = 6; 
      if (tSemaforo >= 5000 && tSemaforo < 6000) tone(PIN_BUZZER, 880); else noTone(PIN_BUZZER); 
    } 
    else {
      noTone(PIN_BUZZER);
      semaforoHardwareActivo = false;
      estadoSemTemp = 0;
      if (carreraEnEspera) {
        carreraEnEspera = false;
        carreraActiva = true;
        inicioPausa = millis();
        tiempoTotalPausado = millis();
      }
    }
    estadoSemaforoVirtual = estadoSemTemp; // Actualiza el estado para enviar a la pantalla
  }
  
  if (carreraActiva && !carreraFinalizada && !carreraEnEspera && modoActual == MODO_TIEMPO) {
    if (obtenerTiempoCarrera() >= limiteTiempoMs) {
      carreraFinalizada = true; carreraActiva = false; inicioPausa = millis();
      int bestId = 0;
      for(int i = 1; i < NUM_CARRILES; i++) {
        int vNetaA = carriles[bestId].vueltas - lastreVueltas[bestId];
        int vNetaB = carriles[i].vueltas - lastreVueltas[i];
        if (vNetaB > vNetaA) { bestId = i; } else if (vNetaB == vNetaA) {
          unsigned long mejA = (carriles[bestId].mejorTiempo == 0) ? 99999999 : carriles[bestId].mejorTiempo;
          unsigned long mejB = (carriles[i].mejorTiempo == 0) ? 99999999 : carriles[i].mejorTiempo;
          if (mejB < mejA) bestId = i;
        }
      }
      idGanador = bestId;
    }
  }

  if (peticionPausa || peticionReanudar) {
    unsigned long tiempoActualLoop = millis();
    if (tiempoActualLoop - ultimoAntireboteComisario > 300) {
      if (comisarioHabilitado && !carreraFinalizada && !carreraEnEspera) {
        if (peticionPausa && digitalRead(PIN_PAUSA_PISTA) == LOW) {
          if (carreraActiva) { carreraActiva = false; inicioPausa = tiempoActualLoop; }
        }
        else if (peticionReanudar && digitalRead(PIN_REANUDAR_PISTA) == LOW) {
          if (!carreraActiva) { carreraActiva = true; tiempoTotalPausado += (tiempoActualLoop - inicioPausa); }
        }
      }
      ultimoAntireboteComisario = tiempoActualLoop;
    }
    peticionPausa = false; peticionReanudar = false;
  }

  for(int id=0; id<NUM_CARRILES; id++) {
    if (nuevaVueltaPendiente[id]) {
      unsigned long tFisico = tiempoDisparo[id];
      nuevaVueltaPendiente[id] = false; 

      if (tFisico - ultimoDisparoFisico[id] >= 500) {
        ultimoDisparoFisico[id] = tFisico;

        if (!carreraActiva || carreraFinalizada || carreraEnEspera) continue; 
        
        unsigned long tiempoActualVirtual;
        if (carreraActiva) tiempoActualVirtual = millis() - tiempoTotalPausado;
        else tiempoActualVirtual = inicioPausa - tiempoTotalPausado;
        
        carriles[id].vueltas++; 
        if (buzzerHabilitado) peticionBuzzer = true; 
        
        if (carriles[id].tiempoUltimaVuelta > 0) { 
          long tiempoCalculado = (tiempoActualVirtual - carriles[id].tiempoUltimaVuelta) + correccionTiempoMs;
          if(tiempoCalculado < 0) tiempoCalculado = 0; 
          carriles[id].tiempoVueltaActual = tiempoCalculado;
          if (carriles[id].tiempoVueltaActual < carriles[id].mejorTiempo) carriles[id].mejorTiempo = carriles[id].tiempoVueltaActual;
        }
        carriles[id].tiempoUltimaVuelta = tiempoActualVirtual;

        if (modoActual == MODO_VUELTAS) {
          int vueltasNetasActuales = carriles[id].vueltas - lastreVueltas[id];
          if (vueltasNetasActuales >= limiteVueltas) {
            carreraFinalizada = true; carreraActiva = false; idGanador = id; inicioPausa = millis(); 
          }
        }
      }
    }
  }
  
  if (millis() - ultimoEnvioEspNow > 100) {
    for(int i=0; i<NUM_CARRILES; i++) {
      datosParaPantallas.vueltasNetas[i] = carriles[i].vueltas - lastreVueltas[i];
      datosParaPantallas.ultimaVuelta[i] = carriles[i].tiempoVueltaActual;
      datosParaPantallas.mejorVuelta[i]  = (carriles[i].mejorTiempo == 999999) ? 0 : carriles[i].mejorTiempo;
    }
    datosParaPantallas.pistaActiva = carreraActiva && !carreraEnEspera;
    datosParaPantallas.finDeCarrera = carreraFinalizada;
    datosParaPantallas.nivelBrillo = nivelBrilloLED; 
    datosParaPantallas.modoCarrera = (int)modoActual;
    datosParaPantallas.limiteVueltas = limiteVueltas;
    datosParaPantallas.limiteTiempo = limiteTiempoMs;
    datosParaPantallas.tiempoCarrera = obtenerTiempoCarrera();
    datosParaPantallas.relojDescendente = relojDescendente; 
    datosParaPantallas.estadoSemaforo = estadoSemaforoVirtual;
    
    esp_now_send(direccionBroadcast, (uint8_t *) &datosParaPantallas, sizeof(datosParaPantallas));
    ultimoEnvioEspNow = millis();
  }
  delay(1); 
}
